# The index is already uniformly LF; this pins that before a second contributor
# on Windows checks out and commits CRLF back in.
* text=auto eol=lf

# Windows-only helper scripts still want CRLF in the working tree.
*.ps1 text eol=crlf

# Binary — never diff, never normalise.
*.png binary
*.jpg binary
*.gif binary
*.webm binary
*.docx binary
*.pptx binary
*.woff binary
*.woff2 binary

# Generated; keep it out of diffs and out of language stats.
package-lock.json -diff linguist-generated=true

# Vendored shadcn/ui primitives are not authored here.
app/components/ui/** linguist-vendored=true
