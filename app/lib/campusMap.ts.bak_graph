export function findBuilding(id: string): Building | undefined {
  return BUILDINGS.find((b) => b.id === id);
}

/** Return BUILDINGS with x/y replaced by admin overrides where present. */
export function applyCoordOverrides(
  overrides: ReadonlyMap<string, { x: number; y: number }>,
): Building[] {
  if (overrides.size === 0) return BUILDINGS.slice();
  return BUILDINGS.map((b) => {
    const o = overrides.get(b.id);
    return o ? { ...b, x: o.x, y: o.y } : b;
  });
}

