// Decorative building footprints — drawn as soft rounded rects behind each
// numbered marker so the map reads like a campus illustration rather than a
// page of pins on green grass.
export function footprintFor(b: Building): { x: number; y: number; w: number; h: number } {
  // Custom footprint sizes for landmark buildings. The Oval is by far the
  // largest single feature on the real campus, so it gets a much bigger
  // green ellipse-style rectangle than everything else.
  const customSizes: Record<string, { w: number; h: number }> = {
    oval: { w: 280, h: 180 },
    cafenr: { w: 200, h: 110 },
    cemds: { w: 200, h: 110 },
    cvmbs: { w: 200, h: 110 },
    icon: { w: 200, h: 110 },
    cas: { w: 200, h: 110 },
    admin: { w: 200, h: 100 },
    library: { w: 200, h: 110 },
    gym: { w: 200, h: 110 },
    agri_eco: { w: 200, h: 110 },
    ncrdec: { w: 220, h: 120 },
    mall: { w: 200, h: 100 },
    star_farm: { w: 220, h: 130 },
    rolle_hall: { w: 200, h: 100 },
  };
  const size = customSizes[b.id] ?? { w: 130, h: 70 };
  return { x: b.x - size.w / 2, y: b.y - size.h / 2, w: size.w, h: size.h };
}

// ============================================================================
// Waypoint graph for shortest-path routing
// ============================================================================
// Each waypoint sits at a major road intersection. Edges connect waypoints
// that share a road segment. Buildings snap to their nearest waypoint, so
// the route from any building A to any building B is:
//   A.center -> A.waypoint -> ... Dijkstra ... -> B.waypoint -> B.center

export interface Waypoint {
  id: string;
  x: number;
  y: number;
  neighbors: readonly string[];
}

// Road-aligned waypoint graph. Every neighbor pair shares either an x
// (same vertical road) or a y (same horizontal road), so the polyline
// between consecutive waypoints stays on a single straight road segment.
// Corner nodes (wp_sw, wp_int_w_admin, wp_int_e_mid) bridge perpendicular
// roads so cross-traffic doesn't cut diagonally through buildings.
export const WAYPOINTS: Record<string, Waypoint> = {
  // ── SOUTH ARTERIAL (y = 1700) ─────────────────────────────────────
  wp_sw:         { id: "wp_sw",         x: 691,  y: 1700, neighbors: ["wp_softball", "wp_plaza"] },
  wp_plaza:      { id: "wp_plaza",      x: 770,  y: 1700, neighbors: ["wp_sw", "wp_gate1"] },
  wp_gate1:      { id: "wp_gate1",      x: 857,  y: 1700, neighbors: ["wp_plaza", "wp_south_row", "wp_oval"] },
  wp_south_row:  { id: "wp_south_row",  x: 1030, y: 1700, neighbors: ["wp_gate1", "wp_mall"] },
  wp_mall:       { id: "wp_mall",       x: 1130, y: 1700, neighbors: ["wp_south_row", "wp_gate3"] },
  wp_gate3:      { id: "wp_gate3",      x: 1208, y: 1700, neighbors: ["wp_mall", "wp_boys_dorm", "wp_bahay"] },
  wp_boys_dorm:  { id: "wp_boys_dorm",  x: 1280, y: 1700, neighbors: ["wp_gate3", "wp_girls_dorm"] },
  wp_girls_dorm: { id: "wp_girls_dorm", x: 1370, y: 1700, neighbors: ["wp_boys_dorm"] },

  // ── WEST PERIMETER (x = 691) ──────────────────────────────────────
  wp_softball:    { id: "wp_softball",    x: 691, y: 1500, neighbors: ["wp_sw", "wp_west"] },
  wp_west:        { id: "wp_west",        x: 691, y: 1450, neighbors: ["wp_softball", "wp_clinic"] },
  wp_clinic:      { id: "wp_clinic",      x: 691, y: 1370, neighbors: ["wp_west", "wp_ccj", "wp_central"] },
  wp_ccj:         { id: "wp_ccj",         x: 691, y: 1250, neighbors: ["wp_clinic", "wp_int_w_admin"] },
