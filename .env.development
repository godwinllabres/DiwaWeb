# Dev-mode overrides — Vite loads .env.development with higher precedence
# than .env during `vite dev`, so dev never talks to the production API.
#
# Chat calls go same-origin to /api; the dev-server proxy (vite.config.ts)
# forwards them to the local Sevi stack. If you run uvicorn directly instead
# of the compose stack, override VITE_API_PROXY_TARGET in .env.local
# (e.g. http://127.0.0.1:8009).
VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8090/api
