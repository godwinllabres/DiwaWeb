{
  "name": "sevi-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "demo:admin-split": "node tests/e2e/admin-codesplit.demo.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "tunnel:start": "powershell -ExecutionPolicy Bypass -File scripts/start-trycloudflare.ps1",
    "tunnel:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-trycloudflare.ps1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-zoom-pan-pinch": "^4.0.3",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.2.5",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.5"
  }
}
