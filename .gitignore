node_modules

# Build artifacts
dist/
coverage/
*.tsbuildinfo

# Regenerated by `npm run demo:admin-split` on every run — the .cjs script
# writes them itself, so a committed copy only ever goes stale.
tests/e2e/screenshots/

# Editor/merge leftovers. These were committed once (app/lib/campusMap.ts.bak*);
# git history is the backup, so a second copy in the tree is pure noise.
*.bak
*.bak_*
*.backup_*
*.orig
*.rej

# Secrets & local env — never commit
.env
.env.local
.env.*.local
.env.production

# Cloudflare tunnel state & logs
.cloudflared/

# Sevi design-asset source library (16MB of PNG/HTML exports; the runtime
# assets the app actually uses live in public/sevi-stickers/,
# public/sevi-reactions/ and SeviAvatar.tsx)
sevi-asset/

# Raw v2 avatar/sticker exports (the shipped copies live in public/sevi-avatar.svg
# and public/sevi-stickers/ — never commit the 7MB source drop)
sevi gif final/
